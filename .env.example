# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# From @BotFather. Leave empty until the bot is created.
BOT_TOKEN=
BOT_USERNAME=

# Local Docker Compose defaults. Change the password before any shared or public host.
DATABASE_URL=postgresql+asyncpg://love:love@localhost:5432/anonymous_love

# Optional. The app stays correct without Redis (in-memory rate limits and FSM).
REDIS_URL=redis://localhost:6379/0

# Required in production. Use long random strings.
ADMIN_JWT_SECRET=change-me-please
IDENTITY_PEPPER=change-me-please

# Creates the first superadmin only when the admin table is empty.
# Use a password of at least 10 characters. Do not keep the sample value.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=local-admin-change-me

# disabled | test | stars | crypto | both
# test is refused when ENVIRONMENT=production.
# stars uses Telegram Stars (currency XTR) and credits coins only after successful_payment.
# crypto uses CryptoBot. both shows Stars and CryptoBot on each package.
# 1 Star is priced at STAR_USD_CENTS cents of CRYPTO_ASSET. Coins arrive only after CryptoBot marks the invoice paid.
PAYMENT_MODE=disabled
CRYPTO_PAY_TOKEN=
CRYPTO_PAY_API=https://pay.crypt.bot/api
CRYPTO_ASSET=USDT
STAR_USD_CENTS=2

USE_WEBHOOK=false
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080

# Public HTTPS URL of the Mini App. Empty hides the Mini App button.
# Telegram only opens Mini Apps over HTTPS.
MINIAPP_URL=

# Optional external age/liveness vendor. Empty keeps manual moderator review.
# The bot never marks a profile approved just because a photo was uploaded.
VERIFICATION_PROVIDER_URL=
VERIFICATION_PROVIDER_KEY=
VERIFICATION_PROVIDER_SECRET=

ACCESS_TOKEN_HOURS=12
MINIAPP_TOKEN_HOURS=12
AUTH_DATE_MAX_AGE_SEC=86400
